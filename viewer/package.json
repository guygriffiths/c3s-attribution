{
	"name": "vue3-skeleton",
	"version": "1.2.0",
	"description": "Example Vue 3 App",
	"scripts": {
		"dev": "vite --config vite.config.ts",
		"build": "vue-tsc --noEmit --project ./ && vite --config vite.config.ts build",
		"deploy": "yarn run build && rm -Rf docs/assets && cp -r dist/* docs && cp dist/index.html docs/404.html && git add docs"
	},
	"author": "Guy Griffiths",
	"license": "ISC",
